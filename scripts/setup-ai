#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
HOME_DIR=${HOME:?}
AI_DIR="$ROOT/userhome/.config/ai-coding"
RULES_DIR="$AI_DIR/rules"
SKILLS_DIR="$AI_DIR/skills"
CODEX_GENERATED_DIR="$AI_DIR/generated/codex"
CODEX_AGENTS="$CODEX_GENERATED_DIR/AGENTS.md"

generate_codex_agents() {
    mkdir -p "$CODEX_GENERATED_DIR"

    {
        printf '<!-- Generated by scripts/setup-ai. Do not edit directly. -->\n'
        printf '<!-- Source: userhome/.config/ai-coding/rules/*.md -->\n\n'
        printf '# User AI Coding Rules\n\n'

        shopt -s nullglob
        local rule
        for rule in "$RULES_DIR"/*.md; do
            printf '<!-- BEGIN %s -->\n\n' "$(basename "$rule")"
            cat "$rule"
            printf '\n\n<!-- END %s -->\n\n' "$(basename "$rule")"
        done
    } >"$CODEX_AGENTS"
}

link_codex_skills() {
    mkdir -p "$HOME_DIR/.codex/skills"

    shopt -s nullglob
    local skill name target link
    for skill in "$SKILLS_DIR"/*; do
        [[ -d "$skill" ]] || continue
        [[ -f "$skill/SKILL.md" ]] || continue

        name=$(basename "$skill")
        target="../../.config/ai-coding/skills/$name"
        link="$HOME_DIR/.codex/skills/$name"

        if [[ -e "$link" && ! -L "$link" ]]; then
            printf 'skip: %s exists and is not a symlink\n' "$link" >&2
            continue
        fi

        ln -sfn "$target" "$link"
    done
}

case "${1:-all}" in
generate)
    generate_codex_agents
    ;;
link-skills)
    link_codex_skills
    ;;
all)
    generate_codex_agents
    link_codex_skills
    ;;
*)
    printf 'usage: %s [generate|link-skills|all]\n' "$0" >&2
    exit 2
    ;;
esac
